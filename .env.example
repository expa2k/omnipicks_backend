# ============================================================
# OmniPicks — Environment Variables
# Copy this file to .env and fill in your credentials
# ============================================================

# === MySQL Database ===
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=omnipicks

# === Bzzoiro Sports Data (Soccer/Football) ===
# Get your free key at: https://sports.bzzoiro.com/register/
BZZOIRO_API_KEY=
BZZOIRO_BASE_URL=https://sports.bzzoiro.com

# === API-Sports (NBA, NFL, MLB) ===
# Get your free key at: https://api-sports.io
# 100 requests/day per sport (free tier)
API_SPORTS_KEY=

# === The Odds API (Betting Lines) ===
# Get your free key at: https://the-odds-api.com
# 500 credits/month (free tier)
ODDS_API_KEY=

# === Application Settings ===
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
APP_HOST=0.0.0.0

# === Frontend URL (for CORS) ===
FRONTEND_URL=http://localhost:4200
# NBA v2: lesiones cada 30 min + histórico diario (gratis)
NBA_SCHEDULER_ENABLED=true
# Correr el pipeline completo al arrancar (gasta cuota de API-Sports y The Odds API)
RUN_PIPELINE_ON_STARTUP=true
